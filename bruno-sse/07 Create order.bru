meta {
  name: Create order
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "shippingAddress": "123 Bruno Test Street"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar("orderId", res.getBody().id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Captures orderId. Expect order.created and cart.updated after asynchronous clearing. Their arrival order may vary.
}
