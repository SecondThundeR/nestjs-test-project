meta {
  name: Watch SSE
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/events
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: text/event-stream
}

script:pre-request {
  req.setTimeout(0);
}

docs {
  Leave this request running while sending requests in other tabs. Expect ready, then heartbeat every 15 seconds. Cart and order mutations appear live. Stop with Cancel.
}
