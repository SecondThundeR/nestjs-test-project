{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals", "supertest", "js-yaml"],
    "paths": {
      "@app/cache": ["./libs/cache/src/index.ts"],
      "@app/cache/*": ["./libs/cache/src/*.ts"],
      "@app/config": ["./libs/config/src/index.ts"],
      "@app/config/*": ["./libs/config/src/*.ts"],
      "@app/domains": ["./libs/domains/src/index.ts"],
      "@app/domains/*": ["./libs/domains/src/*.ts"],
      "@app/filters": ["./libs/filters/src/index.ts"],
      "@app/filters/*": ["./libs/filters/src/*.ts"],
      "@app/logger": ["./libs/logger/src/index.ts"],
      "@app/logger/*": ["./libs/logger/src/*.ts"],
      "@app/utils": ["./libs/utils/src/index.ts"],
      "@app/utils/*": ["./libs/utils/src/*.ts"]
    },
    "ignoreDeprecations": "6.0"
  }
}
