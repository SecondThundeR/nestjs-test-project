{
  "name": "nestjs-test-project",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.2",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "docker:up": "docker compose up -d --build",
    "docker:db": "docker compose up -d --wait products-db cache cart-db orders-db users-db auth-db kafka",
    "docker:down": "docker compose down",
    "build": "nest build --all --parallel",
    "build:gateway": "nest build gateway",
    "build:products": "nest build products",
    "build:cart": "nest build cart",
    "build:orders": "nest build orders",
    "build:users": "nest build users",
    "build:auth": "nest build auth",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway --start",
    "start:products": "nest start products --start",
    "start:cart": "nest start cart --start",
    "start:orders": "nest start orders --start",
    "start:users": "nest start users --start",
    "start:auth": "nest start auth --start",
    "start:dev": "concurrently -n gateway,products,cart,orders,users,auth -c blue,green,magenta,yellow,cyan,red \"pnpm:start:gateway\" \"pnpm:start:products\" \"pnpm:start:cart\" \"pnpm:start:orders\" \"pnpm:start:users\" \"pnpm:start:auth\"",
    "start:prod": "concurrently -n gateway,products,cart,orders,users,auth -c blue,green,magenta,yellow,cyan,red \"node dist/apps/gateway/main.js\" \"node dist/apps/products/main.js\" \"node dist/apps/cart/main.js\" \"node dist/apps/orders/main.js\" \"node dist/apps/users/main.js\" \"node dist/apps/auth/main.js\"",
    "lint": "oxlint --type-aware apps libs test && prettier --check \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "oxlint --type-aware --fix apps libs test && prettier --write \"{apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm:build": "tsc --project tsconfig.typeorm.json",
    "typeorm": "pnpm run typeorm:build && typeorm",
    "migration:run:products": "pnpm run typeorm -- migration:run -d dist/typeorm/apps/products/src/data-source.js",
    "migration:run:cart": "pnpm run typeorm -- migration:run -d dist/typeorm/apps/cart/src/data-source.js",
    "migration:run:orders": "pnpm run typeorm -- migration:run -d dist/typeorm/apps/orders/src/data-source.js",
    "migration:run:users": "pnpm run typeorm -- migration:run -d dist/typeorm/apps/users/src/data-source.js",
    "migration:run:auth": "pnpm run typeorm -- migration:run -d dist/typeorm/apps/auth/src/data-source.js",
    "migration:run:all": "pnpm run migration:run:products && pnpm run migration:run:cart && pnpm run migration:run:orders && pnpm run migration:run:users && pnpm run migration:run:auth",
    "migration:revert:products": "pnpm run typeorm -- migration:revert -d dist/typeorm/apps/products/src/data-source.js",
    "migration:revert:cart": "pnpm run typeorm -- migration:revert -d dist/typeorm/apps/cart/src/data-source.js",
    "migration:revert:orders": "pnpm run typeorm -- migration:revert -d dist/typeorm/apps/orders/src/data-source.js",
    "migration:revert:users": "pnpm run typeorm -- migration:revert -d dist/typeorm/apps/users/src/data-source.js",
    "migration:revert:auth": "pnpm run typeorm -- migration:revert -d dist/typeorm/apps/auth/src/data-source.js"
  },
  "dependencies": {
    "@keyv/redis": "6.1.0",
    "@nestjs/cache-manager": "12.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/cqrs": "12.1.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/typeorm": "12.0.2",
    "bcrypt": "6.0.0",
    "cache-manager": "7.2.9",
    "dotenv": "18.0.9",
    "js-yaml": "5.5.0",
    "kafkajs": "2.2.4",
    "keyv": "6.1.0",
    "nest-winston": "2.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "winston": "3.19.0",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@rspack/core": "2.3.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.6",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "jest-openapi": "0.14.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg-mem": "3.0.14",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "webpack-node-externals": "3.0.0"
  },
  "overrides": {
    "axios": "^1.21.0",
    "js-yaml": "^5.5.0",
    "browserslist": "^4.29.5"
  }
}
