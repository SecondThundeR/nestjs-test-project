{
  "name": "nestjs-test-project",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.4.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "docker:up": "docker compose up -d --build",
    "docker:db": "docker compose up -d products-db cache cart-db orders-db users-db auth-db",
    "docker:down": "docker compose down",
    "build": "nest build gateway && nest build products && nest build cart && nest build orders && nest build users && nest build auth",
    "build:gateway": "nest build gateway",
    "build:products": "nest build products",
    "build:cart": "nest build cart",
    "build:orders": "nest build orders",
    "build:users": "nest build users",
    "build:auth": "nest build auth",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway --start",
    "start:products": "nest start products --start",
    "start:cart": "nest start cart --start",
    "start:orders": "nest start orders --start",
    "start:users": "nest start users --start",
    "start:auth": "nest start auth --start",
    "start:dev": "concurrently -n gateway,products,cart,orders,users,auth -c blue,green,magenta,yellow,cyan,red \"npm:start:gateway\" \"npm:start:products\" \"npm:start:cart\" \"npm:start:orders\" \"npm:start:users\" \"npm:start:auth\"",
    "start:prod": "concurrently -n gateway,products,cart,orders,users,auth -c blue,green,magenta,yellow,cyan,red \"node dist/apps/gateway/main\" \"node dist/apps/products/main\" \"node dist/apps/cart/main\" \"node dist/apps/orders/main\" \"node dist/apps/users/main\" \"node dist/apps/auth/main\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run:products": "npm run typeorm -- migration:run -d apps/products/src/data-source.ts",
    "migration:run:cart": "npm run typeorm -- migration:run -d apps/cart/src/data-source.ts",
    "migration:run:orders": "npm run typeorm -- migration:run -d apps/orders/src/data-source.ts",
    "migration:run:users": "npm run typeorm -- migration:run -d apps/users/src/data-source.ts",
    "migration:run:auth": "npm run typeorm -- migration:run -d apps/auth/src/data-source.ts",
    "migration:run:all": "npm run migration:run:products && npm run migration:run:cart && npm run migration:run:orders && npm run migration:run:users && npm run migration:run:auth",
    "migration:revert:products": "npm run typeorm -- migration:revert -d apps/products/src/data-source.ts",
    "migration:revert:cart": "npm run typeorm -- migration:revert -d apps/cart/src/data-source.ts",
    "migration:revert:orders": "npm run typeorm -- migration:revert -d apps/orders/src/data-source.ts",
    "migration:revert:users": "npm run typeorm -- migration:revert -d apps/users/src/data-source.ts",
    "migration:revert:auth": "npm run typeorm -- migration:revert -d apps/auth/src/data-source.ts"
  },
  "dependencies": {
    "@keyv/redis": "5.1.6",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.1.27",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/typeorm": "11.0.3",
    "bcrypt": "6.0.0",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "keyv": "5.6.0",
    "nest-winston": "1.10.2",
    "passport": "0.7.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.0.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.0",
    "@types/supertest": "7.2.0",
    "concurrently": "10.0.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "jest-openapi": "0.14.2",
    "pg-mem": "3.0.14",
    "prettier": "3.9.4",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.(controller|service).ts",
      "apps/**/common/*.ts",
      "libs/**/filters/*.ts",
      "!apps/!(gateway)/src/*.controller.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "/main\\.ts$",
      "\\.interface\\.ts$",
      "\\.dto\\.ts$",
      "\\.(spec|e2e-spec)\\.ts$"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/cache(|/.*)$": "<rootDir>/libs/cache/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/domains(|/.*)$": "<rootDir>/libs/domains/src/$1",
      "^@app/filters(|/.*)$": "<rootDir>/libs/filters/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1"
    }
  },
  "overrides": {
    "openapi-validator": {
      "axios": "^1.18.1"
    },
    "form-data": "^4.0.6",
    "js-yaml": "^5.2.1",
    "multer": "^2.2.0"
  },
  "allowScripts": {
    "@nestjs/core@11.1.26": true,
    "unrs-resolver@1.12.2": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "@scarf/scarf@1.4.0": true
  }
}
