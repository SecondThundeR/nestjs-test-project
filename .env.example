LOG_LEVEL=info # error | warn | info | http | verbose | debug | silly
LOG_FORMAT=pretty # pretty | json

# Generate new secret with openssl rand --hex 64
JWT_SECRET=secret
JWT_EXPIRES_IN=1h

GATEWAY_PORT=3000
PRODUCTS_PORT=3001
CART_PORT=3002
ORDERS_PORT=3003
USERS_PORT=3004

PRODUCTS_HOST=127.0.0.1
CART_HOST=127.0.0.1
ORDERS_HOST=127.0.0.1
USERS_HOST=127.0.0.1

DB_SYNCHRONIZE=true

PRODUCTS_DB_HOST=127.0.0.1
PRODUCTS_DB_PORT=5532
PRODUCTS_DB_USERNAME=postgres
PRODUCTS_DB_PASSWORD=postgres
PRODUCTS_DB_NAME=products

CART_DB_HOST=127.0.0.1
CART_DB_PORT=5533
CART_DB_USERNAME=postgres
CART_DB_PASSWORD=postgres
CART_DB_NAME=cart

ORDERS_DB_HOST=127.0.0.1
ORDERS_DB_PORT=5534
ORDERS_DB_USERNAME=postgres
ORDERS_DB_PASSWORD=postgres
ORDERS_DB_NAME=orders

USERS_DB_HOST=127.0.0.1
USERS_DB_PORT=5535
USERS_DB_USERNAME=postgres
USERS_DB_PASSWORD=postgres
USERS_DB_NAME=users
