meta {
  name: Cancel idempotent
  type: http
  seq: 32
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/cancel
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response contract", function () { const b = res.getBody(); expect(b.status).to.equal("CANCELLED"); });
}
