meta {
  name: Manual status SHIPPED
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "SHIPPED"
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(400); expect(res.getBody().message).to.exist; });
}
