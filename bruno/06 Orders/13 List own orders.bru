meta {
  name: List own orders
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/orders
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response contract", function () { const b = res.getBody(); expect(b.some(o => o.id === bru.getVar("orderId"))).to.equal(true); expect(b.every(o => o.userId === bru.getVar("userId"))).to.equal(true); });
}
