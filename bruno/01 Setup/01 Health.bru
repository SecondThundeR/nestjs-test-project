meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

script:pre-request {
  const id = Date.now() + "-" + Math.random().toString(36).slice(2); bru.setVar("userEmail", "bruno-" + id + "@example.com"); bru.setVar("otherEmail", "other-" + id + "@example.com");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response contract", function () { const b = res.getBody(); expect(b.status).to.equal("ok"); expect(b.service).to.equal("gateway"); });
}
