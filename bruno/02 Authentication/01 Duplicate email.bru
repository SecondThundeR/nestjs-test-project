meta {
  name: Duplicate email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "name": "Bruno user",
    "password": "{{testPassword}}"
  }
}

tests {
  test("HTTP 409", function () { expect(res.getStatus()).to.equal(409); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(409); expect(res.getBody().message).to.exist; });
}
