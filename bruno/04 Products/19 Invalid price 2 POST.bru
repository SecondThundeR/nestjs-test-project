meta {
  name: Invalid price 2 POST
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/product
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Test",
    "price": 1.001
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(400); expect(res.getBody().message).to.exist; });
}
