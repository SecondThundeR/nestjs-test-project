meta {
  name: Regular forbidden PATCHorders
  type: http
  seq: 40
}

patch {
  url: {{baseUrl}}/orders/{{missingId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "SHIPPED"
  }
}

tests {
  test("HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(403); expect(res.getBody().message).to.exist; });
}
