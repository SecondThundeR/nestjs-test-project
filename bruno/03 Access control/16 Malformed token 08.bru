meta {
  name: Malformed token 08
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/cart/items/{{missingId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid.jwt.token
  Content-Type: application/json
}

body:json {
  {
    "quantity": 1
  }
}

tests {
  test("HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(401); expect(res.getBody().message).to.exist; });
}
