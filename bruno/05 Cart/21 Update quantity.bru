meta {
  name: Update quantity
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/cart/items/{{productId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {
    "quantity": 4
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response contract", function () { const b = res.getBody(); expect(b.total).to.equal(41); expect(b.items[0].subtotal).to.equal(41); });
}
