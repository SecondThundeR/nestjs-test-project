meta {
  name: Missing product
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {
    "productId": "{{missingId}}",
    "quantity": 1
  }
}

tests {
  test("HTTP 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(404); expect(res.getBody().message).to.exist; });
}
