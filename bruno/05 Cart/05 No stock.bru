meta {
  name: No stock
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {
    "productId": "{{zeroProductId}}",
    "quantity": 1
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Error payload", function () { expect(res.getBody().statusCode).to.equal(400); expect(res.getBody().message).to.exist; });
}
